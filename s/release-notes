#!/usr/bin/env bash
# s/release-notes VERSION
#
# Prints the CHANGELOG.md section for VERSION, for the GitHub release notes.
set -euo pipefail

cd "$(dirname "$0")/.."

version=${1#v}

notes=$(awk -v version="$version" '
  /^## / {
    if (found) exit
    heading = $2
    sub(/^v/, "", heading)
    found = heading == version
    next
  }
  found
' CHANGELOG.md | sed -e '/./,$!d')

if [[ -z "$notes" ]]; then
  echo "❌ no CHANGELOG.md section for $version" >&2
  exit 1
fi
printf '%s\n' "$notes"
